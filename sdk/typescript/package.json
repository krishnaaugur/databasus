{
  "name": "@databasus/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript/JavaScript SDK for Databasus automated multi-tenant database backup and restore",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "databasus",
    "backup",
    "restore",
    "postgres",
    "multitenant",
    "sdk"
  ],
  "author": "Databasus",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
